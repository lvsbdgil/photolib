# Generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-use-a-long-random-string

# Admin panel password
ADMIN_PASSWORD=change-me

# Umami analytics (optional — leave blank to disable)
# After first deploy: open Umami at its domain, add your site, copy the Site ID here,
# then redeploy (docker compose up -d photolib) — no image rebuild needed.
UMAMI_SITE_ID=
UMAMI_ADMIN_PASSWORD=change-me
UMAMI_APP_SECRET=change-me-use-a-long-random-string
UMAMI_DB_PASSWORD=change-me
